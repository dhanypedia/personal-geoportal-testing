# Salin berkas ini menjadi .env di VM, lalu isi nilai aslinya di sana.
# Jangan pernah commit berkas .env yang sudah terisi.

# Diisi otomatis oleh Cloud Build pada deploy pertama.
#
# Sebelum build pertama, pakai image yang benar-benar ada sebagai nilai sementara,
# misalnya nginx:1.27-alpine. Jangan memakai nama karangan seperti belum-dibangun,
# karena compose akan mencoba menariknya dan gagal dengan pesan pull access denied.
#
# Nilai kosong juga bermasalah: interpolasi berjalan sebelum service dipilih, jadi
# seluruh perintah docker compose gagal, termasuk yang hanya menyalakan geoserver.
NEXTJS_IMAGE=nginx:1.27-alpine

# Boleh dikosongkan untuk menguji build, Nginx, dan halaman publik.
# Login, Prisma, dan fitur katalog memerlukan database yang valid.
DATABASE_URL=

# Buat dua nilai acak yang berbeda dengan: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRES_IN=1h
NEXTAUTH_SECRET=

# Wajib memakai alamat IP eksternal VM atau domainnya, TANPA slash di akhir,
# contoh: NEXTAUTH_URL=http://IP_EKSTERNAL_VM/portal
# Aplikasi tidak memakai trailingSlash, jadi bentuk kanoniknya tanpa slash.
NEXTAUTH_URL=

# Kata sandi admin GeoServer. Pakai openssl rand -hex 16 supaya hanya berisi huruf
# dan angka. Jangan memakai tanda dolar, karena compose membacanya sebagai variabel
# dan karakter setelahnya bisa hilang tanpa peringatan yang jelas.
GEOSERVER_ADMIN_PASSWORD=

AUTH_API_URL=http://localhost:3000/portal/api

# Origin lengkap aplikasi, TANPA slash di akhir. Dipakai modul katalog 3D versi lama
# untuk memanggil /api/katalog-data-3d/list dan /api/katalog-data-3d/create.
# Nilainya sama dengan NEXTAUTH_URL.
# Kalau dikosongkan, kedua panggilan itu menjadi relatif dan gagal dengan 404.
BASE_URL=http://IP_EKSTERNAL_VM/portal

# Dipakai repository instruktur versi 12 September 2026 ke atas untuk menyusun URL
# berkas model 3D pada src/app/api/katalog-data-3d/create/route.js.
# Kode versi baru memanggil API dengan alamat relatif, jadi BASE_URL tidak lagi
# dibaca. Nilainya sama dengan BASE_URL, yaitu origin ditambah /portal tanpa slash
# di akhir. Kalau variabel ini kosong, URL berkas modelnya menjadi
# "undefined/api/katalog-data-3d/models/..." dan model 3D gagal dibuka.
NEXT_PUBLIC_URL_BASE_PATH=http://IP_EKSTERNAL_VM/portal
