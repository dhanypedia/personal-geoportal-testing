# Salin berkas ini menjadi .env di VM, lalu isi nilai aslinya di sana.
# Jangan pernah commit berkas .env yang sudah terisi.

# Diisi otomatis oleh Cloud Build pada deploy pertama.
# Sebelum build pertama, isi dengan nilai sementara apa pun, misalnya belum-dibangun.
# Nilai kosong membuat SELURUH perintah docker compose gagal, termasuk saat hanya
# menyalakan geoserver dan nginx, karena interpolasi terjadi sebelum service dipilih.
NEXTJS_IMAGE=belum-dibangun

# Boleh dikosongkan untuk menguji build, Nginx, dan halaman publik.
# Login, Prisma, dan fitur katalog memerlukan database yang valid.
DATABASE_URL=

# Buat dua nilai acak yang berbeda dengan: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRES_IN=1h
NEXTAUTH_SECRET=

# Wajib memakai alamat IP eksternal VM dan diakhiri slash, contoh:
# NEXTAUTH_URL=http://IP_EKSTERNAL_VM/portal/
NEXTAUTH_URL=

# Kata sandi admin GeoServer. Pakai openssl rand -hex 16 supaya hanya berisi huruf
# dan angka. Jangan memakai tanda dolar, karena compose membacanya sebagai variabel
# dan karakter setelahnya bisa hilang tanpa peringatan yang jelas.
GEOSERVER_ADMIN_PASSWORD=

AUTH_API_URL=http://localhost:3000/portal/api

# Origin lengkap aplikasi, TANPA slash di akhir. Dipakai modul katalog 3D untuk
# memanggil /api/katalog-data-3d/list dan /api/katalog-data-3d/create.
# Nilainya sama dengan NEXTAUTH_URL, hanya beda tanpa slash di akhir.
# Kalau dikosongkan, kedua panggilan itu menjadi relatif dan gagal dengan 404.
BASE_URL=http://IP_EKSTERNAL_VM/portal
